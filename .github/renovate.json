{
  "extends": [
    "config:base",
    ":disableRateLimiting",
    ":automergePatch",
    ":automergeMinor",
    ":automergePr"
  ],
  "enabled": false,
  "packageRules": [
    {
      "matchPackagePatterns": ["phpstan"],
      "groupName": "phpstan"
    },
    {
      "matchPackagePatterns": ["eslint"],
      "groupName": "eslint"
    },
    {
      "matchPackagePatterns": ["stylelint"],
      "groupName": "stylelint"
    },
    {
      "matchPackagePatterns": ["doctrine/"],
      "groupName": "doctrine"
    }
  ]
}
